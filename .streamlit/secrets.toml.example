# Copy to .streamlit/secrets.toml and fill in. NEVER commit, zip or ship secrets.toml.
# Root-level keys are published to the environment by Streamlit (see app.py).

OPENAI_API_KEY = ""

# Access control (password mode). Generate with:  python -m utils.auth
Need_Password = "1"
SAGE_PASSWORD_HASH = ""            # general users (password A)
# Optional admin password (B): shows technical details and lets admins change the model.
# Generate with:  python -m utils.auth --admin    (must be a DIFFERENT password)
# SAGE_ADMIN_PASSWORD_HASH = ""
# TECHNICAL_DETAILS = "1"          # needed for admins to see the technical details

