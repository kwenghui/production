# Sage configuration template. Copy to .env and fill in.
# NEVER commit, zip or share .env: it holds secrets. (.gitignore excludes it.)
# Every setting is explained in "how to run.txt"; defaults are shown here.

# --- Required ---------------------------------------------------------------
# OpenAI project key (restrict it to this project and set a spending limit).
OPENAI_API_KEY=

# --- Sign-in (ON unless Need_Password is 0/false/no/off) ---------------------
Need_Password=1
# Generate with:  python -m utils.auth          (no quotes needed in .env)
SAGE_PASSWORD_HASH=
# Optional administrator password (a DIFFERENT one):  python -m utils.auth --admin
# SAGE_ADMIN_PASSWORD_HASH=
# TECHNICAL_DETAILS=1            # lets administrators see technical details

# Single sign-on instead of a password (pip install -r requirements-sso.txt):
# SAGE_AUTH_MODE=oidc
# SAGE_OIDC_ALLOWED_DOMAINS=agency.gov.sg
# SAGE_ADMIN_EMAILS=ops.lead@agency.gov.sg

# --- Abuse and cost limits (per Python process) -------------------------------
# SAGE_SESSION_REQUESTS_PER_MINUTE=12
# SAGE_CLIENT_REQUESTS_PER_MINUTE=30
# SAGE_MAX_TOKENS_PER_QUESTION=75000
# SAGE_MAX_MODEL_CALLS_PER_QUESTION=12
# SAGE_MAX_TOOL_ITERATIONS=10
# Behind your own reverse proxy only (otherwise the header can be forged):
# SAGE_CLIENT_IP_HEADER=X-Forwarded-For

# --- Model ---------------------------------------------------------------------
# SAGE_CHAT_MODEL=gpt-5.6-luna
# SAGE_OPENAI_STORE=0            # 1 lets OpenAI retain requests; only if approved

# --- Official data cache ---------------------------------------------------------
# CACHE_DURATION=1440            # minutes a saved table counts as fresh
# SAGE_OFFLINE_ONLY=0            # 1 = never go online; saved tables only
# STATSSG_DB_PATH=data/app_cache.sqlite3

# --- Logs and privacy -------------------------------------------------------------
# SAGE_LOG_RETENTION_DAYS=30
# SAGE_LOG_LEVEL=INFO
# SAGE_LOG_KEY_FILE=.sage_log_key   # pseudonymisation key (created if missing; keep private)

# --- Operators only -----------------------------------------------------------------
# SAGE_ALLOW_ADMIN_TESTS=0       # 1 allows "-- --debug" / "-- --test" start options
# SAGE_STAGE_TIMING=0            # 1 logs slow stages (no question text is logged)

# --- Advanced: every other setting Sage reads (defaults shown) ------------------
# Features (accept 1/true/yes/on and 0/false/no/off; a typo keeps the default)
# SAGE_AI_DISCOVERY=1            # model ranks candidate tables when several fit
# SAGE_FAST_INTENT=1             # obvious questions skip the intent model call
# SAGE_FAST_RAG=1                # use the persisted notes catalogue for context
# SAGE_HYBRID_DISCOVERY=         # keyword+semantic table search (default: on if data/knowledge_base.sqlite3 exists)
# SAGE_CHROMA_SEARCH=            # semantic index search (default: on if data/chroma_singstat exists)
# SAGE_CHROMA_EMBEDDING=openai   # embedding used by the semantic index
# SAGE_KB_CHROMA=0               # knowledge-base candidates also use the semantic index
# SAGE_KB_EMBEDDING=openai       # embedding used when building the knowledge base
# SAGE_USE_HISTORY_CATALOG=0     # also pick candidates from tables this machine answered before (not repeatable)
# SAGE_STORE_ENABLED=1           # keep verified official tables in the local store
# SAGE_STALE_WHILE_REVALIDATE=1  # answer from a slightly old copy, refresh in background
# SAGE_STALE_MAX_FACTOR=7        # ...up to this many times CACHE_DURATION old
# SAGE_SNAPSHOT_CACHE_MB=64      # in-memory cache of verified tables (0-1024)
# SAGE_QUESTION_LOG_MAX_MB=20    # size cap of failed.txt / success.txt
# SAGE_DAILY_TOKEN_LIMIT=5000000 # whole-process daily token ceiling
# SAGE_MAX_SECONDS_PER_QUESTION=120
# SAGE_AUTH_PARALLEL_VERIFY=4    # concurrent password checks (each is memory-hard)
# SAGE_PLATFORM=                 # "streamlit-cloud" tells the security self-check where Sage runs
# Need_Password / NEED_PASSWORD  # either spelling works (see above)
#
# Key files (instead of OPENAI_API_KEY in .env)
# SAGE_OPENAI_API_KEY_FILE=      # path to a file holding only the key
# CREDENTIALS_DIRECTORY=         # set by systemd; the key file "openai_api_key" is read from it
#
# Safeguard-relaxing switches: ONLY the exact value 1 turns them on
# SAGE_ALLOW_UNLIMITED=0         # lets a 0 budget mean "no limit"
# SAGE_ALLOW_SHARED_PASSWORD_ADMIN=0  # password mode: every signed-in user is an administrator
# SAGE_ALLOW_LOCAL_EMBEDDING_MODEL=0  # knowledge-base tool may download a local model
# SAGE_DEV_RELOAD=0              # reload an edited core file on the next click
# SAGE_FULL_DEBUG_LOG=0          # per-question diagnostics file (privacy-reviewed)
# SAGE_STAGE_TIMING=0            # log slow stages (old name SAGE_PHASE8_DIAGNOSTICS)
#
# Sign-in and sessions
# SAGE_SESSION_IDLE_MINUTES=60   # lock after this much inactivity (5-1440); work is kept until sign-in
# SAGE_SESSION_MAX_HOURS=8       # ...and after this long in any case (1-168)
# SAGE_AUTH_MAX_FAILURES=5       # wrong passwords before a client is locked out (3-20)
# SAGE_AUTH_LOCK_SECONDS=30      # first lock-out in seconds; doubles on repeat (5-3600)
# SAGE_AUTH_GLOBAL_FAILURE_LIMIT=100  # failures from all clients before everyone waits
# SAGE_OIDC_PROVIDER=            # name of the identity provider in .streamlit/secrets.toml
# SAGE_OIDC_TRUST_UNVERIFIED_EMAIL=0  # exactly 1: accept a missing email_verified claim
# SAGE_OIDC_ALLOW_ANY_USER=0     # exactly 1: any signed-in account may use Sage (no allow-list)
# Sage_Password                  # NOT supported any more: use SAGE_PASSWORD_HASH
#
# Logs
# SAGE_DEBUG_LOG_FILE=debug.txt  # where the opt-in diagnostics are written
# SAGE_DEBUG_LOG_MAX_MB=10       # size cap of that file (1-1024)
# SAGE_LOG_PSEUDONYM_KEY=        # key for question pseudonyms (else .sage_log_key)
# SAGE_LOG_MANUAL_QUESTION_TEXT=0  # 1 keeps typed question text in logs (personal data)
#
# Model
# SAGE_REASONING_EFFORT=         # minimal | low | medium | high (unset = model default)
